  "rules": [
    {
      "id": "R1",
      "name": "Egyptian nationality",
      "scope": "global",
      "expression": "nationality == \"egyptian\"",
      "source": "S",
      "indicative": false,
      "on_fail": {
        "reason_code": "NATIONALITY",
        "message": "This loan is available to Egyptian nationals only.",
        "suggestion": "You can ask a Banque Misr branch about other programs available to you."
      }
    },
    {
      "id": "R2",
      "name": "Minimum borrower age",
      "scope": "global",
      "parameters": {
        "min_age": 21
      },
      "expression": "age >= min_age",
      "source": "S",
      "indicative": false,
      "on_fail": {
        "reason_code": "MIN_AGE",
        "message": "The minimum age to borrow is {min_age} years.",
        "suggestion": "You can apply once you reach {min_age} years of age."
      }
    },
    {
      "id": "R3",
      "name": "Loan amount within the program range",
      "scope": "program",
      "expression": "program.min_loan_egp <= loan_amount <= program.max_loan_egp",
      "source": "C",
      "indicative": false,
      "on_fail": {
        "reason_code": "LOAN_AMOUNT_RANGE",
        "message": "The requested amount of {loan_amount} EGP is outside the range for this program ({min_loan} to {max_loan} EGP).",
        "suggestion": "Choose an amount within this range."
      }
    },
    {
      "id": "R4",
      "name": "Tenor within the program range",
      "scope": "program",
      "expression": "program.min_tenor_months <= tenor_months <= program.max_tenor_months",
      "source": "C",
      "indicative": false,
      "on_fail": {
        "reason_code": "TENOR_RANGE",
        "message": "The requested tenor of {tenor_months} months is outside the range for this program ({min_tenor} to {max_tenor} months).",
        "suggestion": "Choose a tenor within this range."
      }
    },
    {
      "id": "R5",
      "name": "Financing ratio within the program band",
      "scope": "program",
      "expression": "program.financing_ratio.min_exclusive < (loan_amount / car_price) <= program.financing_ratio.max_inclusive",
      "notes": "Deemed-income programs are chosen by ratio band: new car up to 40%, 40-50%, 50-60%; used car up to 50%, 50-60%. Other programs only require loan_amount <= car_price. Above 60% no deemed-income program applies.",
      "source": "C",
      "indicative": false,
      "on_fail": {
        "reason_code": "FINANCING_RATIO",
        "message": "The requested loan is {ratio_pct}% of the car price, which is above the maximum financing ratio of {max_ratio_pct}% for this type of financing.",
        "suggestion": "Increase your down payment or consider a lower-priced car."
      }
    },
    {
      "id": "R6",
      "name": "Program matches employment type and car condition",
      "scope": "program",
      "expression": "all conditions in program.applies_when are satisfied by the applicant inputs",
      "source": "C+S",
      "indicative": false,
      "notes": "Used cars are financed only under the deemed-income programs (P3, P5). Programs P6-P10 apply to new cars.",
      "on_fail": {
        "reason_code": "NO_MATCHING_PROGRAM",
        "message": "No financing program matches your employment type and car condition.",
        "suggestion": "A Banque Misr branch can tell you about other options."
      }
    },
    {
      "id": "R7",
      "name": "Maximum age at loan maturity",
      "scope": "program",
      "parameters": {
        "max_age_at_maturity": 65
      },
      "expression": "age + tenor_months / 12 <= max_age_at_maturity",
      "source": "A",
      "indicative": true,
      "on_fail": {
        "reason_code": "AGE_AT_MATURITY",
        "message": "Your age at the end of the loan would be about {age_at_maturity}, above the limit of {max_age_at_maturity}.",
        "suggestion": "Choose a tenor of at most {max_tenor_for_age} months."
      }
    },
    {
      "id": "R8",
      "name": "Debt burden ratio",
      "scope": "program",
      "applies_to": "non_deemed_programs",
      "parameters": {
        "max_dbr": 0.4
      },
      "expression": "(existing_monthly_installments + monthly_payment) / net_monthly_income <= max_dbr",
      "source": "A",
      "indicative": true,
      "on_fail": {
        "reason_code": "DEBT_BURDEN",
        "message": "With this loan, your monthly installments would be {dbr_pct}% of your income, above the {max_dbr_pct}% limit.",
        "suggestion": "Choose a longer tenor (within the program limit) or a lower amount. The maximum comfortable loan for your income is about {max_affordable_loan} EGP."
      }
    },
    {
      "id": "R9",
      "name": "Minimum net monthly income",
      "scope": "program",
      "applies_to": "non_deemed_programs",
      "parameters": {
        "min_net_monthly_income_egp": 8000
      },
      "expression": "net_monthly_income >= min_net_monthly_income_egp",
      "source": "A",
      "indicative": true,
      "on_fail": {
        "reason_code": "MIN_INCOME",
        "message": "The minimum net monthly income for this program is {min_income} EGP.",
        "suggestion": "You may apply once your income reaches this level."
      }
    },
    {
      "id": "R10",
      "name": "Minimum time in current job or business",
      "scope": "program",
      "applies_to": "non_deemed_programs",
      "parameters": {
        "min_months": 6
      },
      "expression": "months_in_current_job_or_business >= min_months",
      "source": "A",
      "indicative": true,
      "on_fail": {
        "reason_code": "MIN_TENURE",
        "message": "A minimum of {min_months} months in your current job or business is required.",
        "suggestion": "You can apply once you complete {min_months} months."
      }
    }
  ],
  "formulas": {
    "monthly_rate": "annual_interest_rate_pct / 100 / 12",
    "monthly_payment": "loan_amount * (r + r / ((1 + r) ** tenor_months - 1)), where r = monthly_rate; round to 2 decimals",
    "total_repayment": "monthly_payment * tenor_months",
    "total_interest": "total_repayment - loan_amount",
    "financing_ratio": "loan_amount / car_price",
    "dbr": "(existing_monthly_installments + monthly_payment) / net_monthly_income",
    "age_at_maturity": "age + tenor_months / 12",
    "max_tenor_for_age": "floor((max_age_at_maturity - age) * 12)",
    "max_affordable_loan": "(max_dbr * net_monthly_income - existing_monthly_installments) / (r + r / ((1 + r) ** tenor_months - 1))",
    "source": "C"
  },
