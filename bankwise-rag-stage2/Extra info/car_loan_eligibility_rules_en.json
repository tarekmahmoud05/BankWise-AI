{
  "metadata": {
    "name": "BankWise AI – Banque Misr car loan eligibility rules",
    "version": "1.0",
    "language": "en",
    "bank": "Banque Misr",
    "product": "Car loan pre-eligibility check",
    "purpose": "Advice and information only. The assistant checks self-declared answers against these rules and refers likely-eligible customers to the nearest branch. It does not receive or verify documents.",
    "disclaimer": "This is a preliminary, non-binding indication, not an approval. The final decision belongs to Banque Misr after document review and its own credit assessment.",
    "source_legend": {
      "C": "Banque Misr car loan calculator data",
      "S": "Banque Misr car loan descriptive text",
      "A": "Project assumption, indicative only, to be validated"
    },
    "out_of_scope": [
      "Savings-instrument holder program (no calculator data)"
    ]
  },
  "decisions": {
    "LIKELY_ELIGIBLE": {
      "label": "Likely eligible",
      "message_template": "Based on what you told me, you appear to meet the conditions for the program \"{program_name}\". The estimated monthly installment is {monthly_payment} EGP at an annual rate of {annual_rate}% over {tenor_months} months. Please visit your nearest Banque Misr branch to complete your application. Here is the list of documents the bank usually asks for there.",
      "next_step": "release_document_checklist_and_refer_to_branch"
    },
    "NOT_ELIGIBLE": {
      "label": "Not eligible at the moment",
      "message_template": "Based on what you told me, you do not currently meet this condition: {reason}. {suggestion}",
      "next_step": "explain_failed_rules_and_suggest_changes"
    },
    "NEED_MORE_INFO": {
      "label": "More information needed",
      "message_template": "To check your eligibility I still need the following: {missing_fields}.",
      "next_step": "ask_only_for_missing_fields"
    }
  },
  "decision_logic": [
    "1. Collect inputs. If any always-required input is missing, return NEED_MORE_INFO and ask only for the missing fields.",
    "2. Evaluate the global rules R1 and R2. If any fails, return NOT_ELIGIBLE with that reason.",
    "3. Select candidate programs with R6 (employment type, car condition, employer inputs).",
    "4. Evaluate the deemed-income programs first (they do not need income inputs): R3, R4, R5, R7. If at least one passes, return LIKELY_ELIGIBLE.",
    "5. If none passes and income inputs are missing, return NEED_MORE_INFO for net_monthly_income, existing_monthly_installments and months_in_current_job_or_business, but only if a non-deemed program is still a candidate after R6.",
    "6. Evaluate the remaining candidate programs with R3, R4, R5, R7, R8, R9, R10. If at least one passes, return LIKELY_ELIGIBLE.",
    "7. If several programs pass, present the one with the lowest monthly installment and mention the others briefly.",
    "8. If no program passes, return NOT_ELIGIBLE and report the failed rules of the candidate program with the fewest failures (ties: lowest interest rate), including suggestions."
  ],
