  "rules": [
    {
      "id": "R1",
      "name": "الجنسية المصرية",
      "scope": "global",
      "expression": "nationality == \"egyptian\"",
      "source": "S",
      "indicative": false,
      "on_fail": {
        "reason_code": "NATIONALITY",
        "message": "هذا القرض متاح للمصريين فقط.",
        "suggestion": "يمكنك الاستفسار في أقرب فرع لبنك مصر عن البرامج الأخرى المتاحة لك."
      }
    },
    {
      "id": "R2",
      "name": "الحد الأدنى لعمر المقترض",
      "scope": "global",
      "parameters": {
        "min_age": 21
      },
      "expression": "age >= min_age",
      "source": "S",
      "indicative": false,
      "on_fail": {
        "reason_code": "MIN_AGE",
        "message": "الحد الأدنى لعمر المقترض هو {min_age} عاماً.",
        "suggestion": "يمكنك التقدم بالطلب عند بلوغك {min_age} عاماً."
      }
    },
    {
      "id": "R3",
      "name": "مبلغ القرض ضمن حدود البرنامج",
      "scope": "program",
      "expression": "program.min_loan_egp <= loan_amount <= program.max_loan_egp",
      "source": "C",
      "indicative": false,
      "on_fail": {
        "reason_code": "LOAN_AMOUNT_RANGE",
        "message": "المبلغ المطلوب {loan_amount} جنيه خارج حدود هذا البرنامج (من {min_loan} إلى {max_loan} جنيه).",
        "suggestion": "اختر مبلغاً ضمن هذا النطاق."
      }
    },
    {
      "id": "R4",
      "name": "مدة التمويل ضمن حدود البرنامج",
      "scope": "program",
      "expression": "program.min_tenor_months <= tenor_months <= program.max_tenor_months",
      "source": "C",
      "indicative": false,
      "on_fail": {
        "reason_code": "TENOR_RANGE",
        "message": "المدة المطلوبة {tenor_months} شهراً خارج حدود هذا البرنامج (من {min_tenor} إلى {max_tenor} شهراً).",
        "suggestion": "اختر مدة ضمن هذا النطاق."
      }
    },
    {
      "id": "R5",
      "name": "نسبة التمويل ضمن شريحة البرنامج",
      "scope": "program",
      "expression": "program.financing_ratio.min_exclusive < (loan_amount / car_price) <= program.financing_ratio.max_inclusive",
      "notes": "تُختار برامج الدخل الافتراضي حسب شريحة النسبة: السيارة الجديدة حتى 40% ثم 40–50% ثم 50–60%، والمستعملة حتى 50% ثم 50–60%. باقي البرامج تشترط فقط ألا يتجاوز القرض سعر السيارة. ما فوق 60% لا ينطبق أي برنامج دخل افتراضي.",
      "source": "C",
      "indicative": false,
      "on_fail": {
        "reason_code": "FINANCING_RATIO",
        "message": "القرض المطلوب يمثل {ratio_pct}% من سعر السيارة، وهي أعلى من الحد الأقصى لنسبة التمويل ({max_ratio_pct}%) لهذا النوع من التمويل.",
        "suggestion": "قم بزيادة الدفعة المقدمة أو فكّر في سيارة بسعر أقل."
      }
    },
    {
      "id": "R6",
      "name": "البرنامج يطابق نوع العمل وحالة السيارة",
      "scope": "program",
      "expression": "all conditions in program.applies_when are satisfied by the applicant inputs",
      "source": "C+S",
      "indicative": false,
      "notes": "السيارات المستعملة تُموَّل فقط ضمن برامج الدخل الافتراضي (P3 وP5). برامج P6 إلى P10 تنطبق على السيارات الجديدة.",
      "on_fail": {
        "reason_code": "NO_MATCHING_PROGRAM",
        "message": "لا يوجد برنامج تمويل مطابق لنوع عملك وحالة السيارة.",
