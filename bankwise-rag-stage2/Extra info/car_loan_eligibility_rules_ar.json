{
  "metadata": {
    "name": "BankWise AI – Banque Misr car loan eligibility rules",
    "version": "1.0",
    "language": "ar",
    "bank": "بنك مصر",
    "product": "الفحص المبدئي لأهلية قرض السيارة",
    "purpose": "للإرشاد والمعلومات فقط. يفحص المساعد إجابات العميل المصرح بها ذاتياً وفق هذه القواعد ويوجه المؤهلين مبدئياً إلى أقرب فرع. لا يستقبل المساعد المستندات ولا يتحقق منها.",
    "disclaimer": "هذه إفادة مبدئية غير ملزمة وليست موافقة. القرار النهائي لبنك مصر بعد مراجعة المستندات وإجراء التقييم الائتماني الخاص به.",
    "source_legend": {
      "C": "بيانات حاسبة قروض السيارات لبنك مصر",
      "S": "النص الوصفي لقرض السيارة من بنك مصر",
      "A": "افتراض من المشروع، إرشادي فقط ويحتاج إلى تأكيد"
    },
    "out_of_scope": [
      "برنامج أصحاب الأوعية الادخارية (لا توجد بيانات في الحاسبة)"
    ]
  },
  "decisions": {
    "LIKELY_ELIGIBLE": {
      "label": "مؤهل مبدئياً",
      "message_template": "بناءً على المعلومات التي ذكرتها، يبدو أنك تستوفي شروط برنامج \"{program_name}\". القسط الشهري التقديري {monthly_payment} جنيه بسعر عائد سنوي {annual_rate}% لمدة {tenor_months} شهراً. يرجى التوجه إلى أقرب فرع لبنك مصر لاستكمال طلبك. وفيما يلي قائمة المستندات التي يطلبها البنك عادة في الفرع.",
      "next_step": "release_document_checklist_and_refer_to_branch"
    },
    "NOT_ELIGIBLE": {
      "label": "غير مؤهل حالياً",
      "message_template": "بناءً على المعلومات التي ذكرتها، لا تستوفي حالياً الشرط التالي: {reason}. {suggestion}",
      "next_step": "explain_failed_rules_and_suggest_changes"
    },
    "NEED_MORE_INFO": {
      "label": "معلومات ناقصة",
      "message_template": "لأتمكن من فحص أهليتك أحتاج إلى المعلومات التالية: {missing_fields}.",
      "next_step": "ask_only_for_missing_fields"
    }
  },
  "decision_logic": [
    "1. جمع المدخلات. إذا كان أي مدخل إلزامي ناقصاً يُرجع NEED_MORE_INFO ويُطلب الناقص فقط.",
    "2. تقييم القواعد العامة R1 وR2. إذا فشلت إحداهما يُرجع NOT_ELIGIBLE مع السبب.",
    "3. اختيار البرامج المرشحة بالقاعدة R6 (نوع العمل وحالة السيارة ومدخلات جهة العمل).",
    "4. تقييم برامج الدخل الافتراضي أولاً (لا تحتاج مدخلات الدخل): R3 وR4 وR5 وR7. إذا نجح أحدها يُرجع LIKELY_ELIGIBLE.",
    "5. إذا لم ينجح أي برنامج وكانت مدخلات الدخل ناقصة يُرجع NEED_MORE_INFO لطلب صافي الدخل والأقساط الحالية ومدة العمل، بشرط أن يبقى برنامج غير افتراضي مرشحاً بعد R6.",
    "6. تقييم باقي البرامج المرشحة بالقواعد R3 وR4 وR5 وR7 وR8 وR9 وR10. إذا نجح أحدها يُرجع LIKELY_ELIGIBLE.",
    "7. إذا نجح أكثر من برنامج يُعرض الأقل قسطاً شهرياً مع ذكر الباقي باختصار.",
    "8. إذا لم ينجح أي برنامج يُرجع NOT_ELIGIBLE ويذكر القواعد الفاشلة للبرنامج الأقل إخفاقاً (عند التساوي الأقل سعر عائد) مع الاقتراحات."
  ],
