  "rules": [
    {
      "id": "R1",
      "name": "الحد الأدنى لعمر المقترض",
      "scope": "program",
      "check": "min_age",
      "source": "S",
      "indicative": false,
      "on_fail": {
        "reason_code": "MIN_AGE",
        "message": "الحد الأدنى لعمر المقترض في هذا البرنامج هو {min_age} عاماً.",
        "suggestion": "يمكنك التقدم بالطلب عند بلوغك {min_age} عاماً."
      },
      "note": "الحد الأدنى للسن يأتي من الحقل age في كل برنامج (٢١ أو ٢٥ حسب الصفحة)."
    },
    {
      "id": "R2",
      "name": "الحد الأقصى للعمر عند نهاية القرض",
      "scope": "program",
      "check": "max_age_at_maturity",
      "source": "S",
      "indicative": false,
      "on_fail": {
        "reason_code": "AGE_AT_MATURITY",
        "message": "عمرك عند نهاية القرض سيكون حوالي {age_at_maturity} عاماً، وهو أعلى من الحد الأقصى ({max_age_at_maturity}).",
        "suggestion": "اختر مدة لا تتجاوز {max_tenor_for_age} شهراً."
      },
      "note": "٦٥ سنة لمعظم البرامج و٧٠ للمعاشات؛ الحد في الحقل age لكل برنامج. البرامج التي لم تنشر الصفحة سنها مصنفة A."
    },
    {
      "id": "R3",
      "name": "مبلغ القرض ضمن حدود البرنامج",
      "scope": "program",
      "check": "amount_range",
      "source": "C",
      "indicative": false,
      "on_fail": {
        "reason_code": "LOAN_AMOUNT_RANGE",
        "message": "المبلغ المطلوب {loan_amount} جنيه خارج حدود هذا البرنامج (من {min_loan} إلى {max_loan} جنيه).",
        "suggestion": "اختر مبلغاً ضمن هذا النطاق."
      }
    },
    {
      "id": "R4",
      "name": "مدة التمويل ضمن حدود البرنامج",
      "scope": "program",
      "check": "tenor_range",
      "source": "C",
      "indicative": false,
      "on_fail": {
        "reason_code": "TENOR_RANGE",
        "message": "المدة المطلوبة {tenor_months} شهراً خارج حدود هذا البرنامج (من {min_tenor} إلى {max_tenor} شهراً).",
        "suggestion": "اختر مدة ضمن هذا النطاق."
      }
    },
    {
      "id": "R5",
      "name": "نسبة الأقساط إلى الدخل",
      "scope": "program",
      "check": "dbr",
      "parameters": {
        "max_dbr": 0.5
      },
      "source": "F",
      "indicative": false,
      "on_fail": {
        "reason_code": "DEBT_BURDEN",
        "message": "مع هذا القرض ستمثل أقساطك الشهرية {dbr_pct}% من دخلك، وهي أعلى من الحد ({max_dbr_pct}%).",
        "suggestion": "اختر مدة أطول (ضمن حد البرنامج) أو مبلغاً أقل. الحد الأقصى المناسب لدخلك حوالي {max_affordable_loan} جنيه."
      },
      "note": "المصدر FAQ بنك مصر (RET-002): قسط التمويل بحد أقصى 50% من الدخل الشهري. الصفحة لا توضح هل الدخل إجمالي أم صافي، ولذلك يُسأل العميل عن صافي الدخل الشهري كتحفظ."
    },
    {
      "id": "R6",
      "name": "مدة التمويل لا تتجاوز المدة المتبقية حتى التسريح",
      "scope": "program",
      "check": "tenor_until_discharge",
      "source": "S",
      "indicative": false,
      "on_fail": {
        "reason_code": "TENOR_UNTIL_DISCHARGE",
        "message": "مدة التمويل المطلوبة {tenor_months} شهراً تتجاوز المدة المتبقية حتى تاريخ التسريح ({months_until_discharge} شهراً).",
        "suggestion": "اختر مدة لا تتجاوز {months_until_discharge} شهراً."
      }
    },
    {
      "id": "R7",
      "name": "الحد الأدنى لصافي الدخل الشهري",
      "scope": "program",
      "check": "min_income",
      "parameters": {
        "min_net_monthly_income_egp": 8000
      },
      "enabled": false,
      "source": "A",
      "indicative": true,
      "on_fail": {
        "reason_code": "MIN_INCOME",
        "message": "الحد الأدنى لصافي الدخل الشهري لهذا البرنامج هو {min_income} جنيه.",
        "suggestion": "يمكنك التقدم عندما يصل دخلك إلى هذا الحد."
      },
      "note": "غير منشور من البنك. معطّلة افتراضياً؛ الرقم افتراض من المشروع (نفس افتراض ملف قرض السيارة)."
    },
    {
      "id": "R8",
      "name": "الحد الأدنى لمدة العمل أو النشاط الحالي",
      "scope": "program",
      "check": "min_months",
      "parameters": {
        "min_months": 6
      },
      "enabled": false,
      "source": "A",
      "indicative": true,
      "on_fail": {
        "reason_code": "MIN_TENURE",
        "message": "يشترط قضاء {min_months} شهور على الأقل في العمل أو النشاط الحالي.",
        "suggestion": "يمكنك التقدم بعد إتمام {min_months} شهور."
      },
      "note": "غير منشور من البنك. معطّلة افتراضياً."
    }
  ],
  "formulas": {
    "monthly_rate": "annual_interest_rate_pct / 100 / 12",
    "monthly_payment": "loan_amount * (r + r / ((1 + r) ** tenor_months - 1)), where r = monthly_rate; round to 2 decimals",
    "total_repayment": "monthly_payment * tenor_months",
    "total_interest": "total_repayment - loan_amount",
    "dbr": "(existing_monthly_installments + monthly_payment) / net_monthly_income",
    "age_at_maturity": "age + tenor_months / 12",
    "max_tenor_for_age": "floor((max_age_at_maturity - age) * 12)",
    "max_affordable_loan": "(max_dbr * net_monthly_income - existing_monthly_installments) / (r + r / ((1 + r) ** tenor_months - 1))",
    "source": "C"
  },
  "branch_handoff": {
    "model_requires_documents": false,
    "released_when": "LIKELY_ELIGIBLE",
    "note": "تُعرض القائمة للعميل لزيارة الفرع فقط. لا يطلب المساعد المستندات ولا يستقبلها ولا يتحقق منها.",
    "referral_message": "يرجى التوجه إلى أقرب فرع لبنك مصر."
  }
}