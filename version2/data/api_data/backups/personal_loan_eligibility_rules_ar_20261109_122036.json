{
  "metadata": {
    "name": "BankWise AI – Banque Misr personal loan eligibility rules",
    "version": "1.0",
    "language": "ar",
    "bank": "بنك مصر",
    "product": "الفحص المبدئي لأهلية القرض الشخصي",
    "purpose": "للإرشاد والمعلومات فقط. يفحص المساعد إجابات العميل المصرح بها ذاتياً وفق هذه القواعد ويوجه المؤهلين مبدئياً إلى أقرب فرع. لا يستقبل المساعد المستندات ولا يتحقق منها.",
    "disclaimer": "هذه إفادة مبدئية غير ملزمة وليست موافقة. القرار النهائي لبنك مصر بعد مراجعة المستندات وإجراء التقييم الائتماني الخاص به، بما في ذلك السجل الائتماني الذي لا يفحصه المساعد.",
    "accessed": "2026-10-22",
    "source_legend": {
      "C": "بيانات حاسبة القروض الشخصية لبنك مصر (personal loan details.txt)",
      "S": "النص الوصفي لصفحة القروض الشخصية لبنك مصر",
      "F": "الأسئلة الشائعة لبنك مصر (RET-002)",
      "A": "افتراض من المشروع، إرشادي فقط ويحتاج إلى تأكيد"
    },
    "out_of_scope": [
      "سلفة على الراتب",
      "القرض النقدي المضمون",
      "السحب على المكشوف بضمان أو مقابل المكافأة السنوية",
      "السجل الائتماني وموافقة جهة العمل (لا يفحصهما المساعد)"
    ],
    "notes": [
      "برامج الحاسبة التي تتطابق شروطها (مثل 'والمستحقات' و'دون المستحقات') دُمجت في برنامج واحد وأُدرجت أسماؤها في calculator_names.",
      "برامج الدخل الافتراضي (deemed) لا تُطبق عليها قاعدة نسبة القسط للدخل لأن الدخل يُحتسب بصيغة البرنامج؛ هذا افتراض إرشادي. ما عداPL18",
      "سن البرامج المصنفة A لم تنشره الصفحة؛ استُخدمت الحدود العامة 21 و65.",
      "حدود الصفحة والحاسبة قد تختلف (مثل المعاشات: الصفحة 1,000,000 والحاسبة 500,000 لبعض البرامج)؛ الملف يتبع الحاسبة."
    ]
  },
  "decisions": {
    "LIKELY_ELIGIBLE": {
      "label": "مؤهل مبدئياً",
      "message_template": "بناءً على المعلومات التي ذكرتها، يبدو أنك تستوفي شروط برنامج \"{program_name}\". القسط الشهري التقديري {monthly_payment} جنيه بسعر عائد سنوي {annual_rate}% لمدة {tenor_months} شهراً. هذه إفادة مبدئية وليست موافقة. يرجى التوجه إلى أقرب فرع لبنك مصر لاستكمال طلبك، وفيما يلي المستندات التي يطلبها البنك عادة.",
      "next_step": "release_document_checklist_and_refer_to_branch"
    },
    "NOT_ELIGIBLE": {
      "label": "غير مؤهل حالياً",
      "message_template": "بناءً على المعلومات التي ذكرتها، لا تستوفي حالياً الشرط التالي: {reason}. {suggestion}",
      "next_step": "explain_failed_rules_and_suggest_changes"
    },
    "NEED_MORE_INFO": {
      "label": "معلومات ناقصة",
      "message_template": "لأتمكن من فحص أهليتك أحتاج إلى المعلومات التالية: {missing_fields}.",
      "next_step": "ask_only_for_missing_fields"
    },
    "INVALID_INPUT": {
      "label": "مدخلات غير صالحة",
      "message_template": "بعض القيم غير صالحة: {errors}. من فضلك صحّحها.",
      "next_step": "ask_user_to_correct_values"
    }
  },
  "decision_logic": [
    "1. التحقق من المدخلات. أي قيمة غير صالحة تُرجع INVALID_INPUT، وأي مدخل إلزامي ناقص يُرجع NEED_MORE_INFO.",
    "2. اختيار البرامج المرشحة من شروط applies_when (نوع العمل وتعهد الجهة وغيرها). إن لم يوجد برنامج يُرجع NOT_ELIGIBLE بسبب NO_MATCHING_PROGRAM.",
    "3. تقييم قواعد كل برنامج مرشح حسب rules_evaluated، وتُتخطى القواعد المعطلة (enabled=false).",
    "4. إذا نجح برنامج أو أكثر يُرجع LIKELY_ELIGIBLE بالبرنامج الأقل قسطاً مع ذكر الباقي باختصار وقائمة المستندات.",
    "5. إذا لم ينجح أي برنامج وبقي برنامج مرشح تنقصه مدخلات الدخل أو تاريخ التسريح، يُرجع NEED_MORE_INFO لطلب الناقص فقط.",
    "6. إذا لم ينجح أي برنامج يُرجع NOT_ELIGIBLE بالقواعد الفاشلة للبرنامج الأقل إخفاقاً (عند التساوي الأقل سعر عائد) مع الاقتراحات."
  ],
