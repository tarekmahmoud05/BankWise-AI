# Copy to version2/.env and fill in ONE provider. Never commit .env.
LLM_PROVIDER=anthropic          # anthropic | openai | gemini

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# LLM_MODEL=                    # empty = default per provider (see chatbot/config.py)
# LLM_TEMPERATURE=0.2
# BANKWISE_MIN_SCORE=0.50       # retrieval threshold: calibrate with embedding/eval_real/eval_retrieval.py
# BANKWISE_TOP_K=4
